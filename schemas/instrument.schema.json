{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARSAM Instrument Record",
  "type": "object",
  "required": [
    "id",
    "family",
    "sourceId",
    "status",
    "language",
    "construct",
    "properties",
    "invariance",
    "rights"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^s-"
    },
    "status": {
      "enum": [
        "development",
        "adaptation",
        "validation",
        "independent-validation"
      ]
    },
    "language": {
      "type": "string"
    },
    "construct": {
      "type": "string"
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariance": {
      "type": "string"
    },
    "rights": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
